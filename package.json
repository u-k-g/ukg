{
  "name": "ukg",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy": "alchemy",
    "build": "nix build .#site --out-link dist",
    "build:resume": "nix build .#resume --out-link resume.pdf",
    "build:printer": "pnpm --filter @ukg/stake-printer build",
    "check": "tsrs --noEmit -p tsconfig.json",
    "lint": "oxlint --no-ignore --deny-warnings alchemy.run.ts scripts/*.cjs apps/stake-printer/*.cjs apps/stake-printer/sw.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "pnpm build && node scripts/serve.cjs",
    "test": "pnpm --filter @ukg/stake-printer test",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "alchemy": "0.93.12",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0"
}
